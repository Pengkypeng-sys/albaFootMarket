# Database (Turso). Dev lokal tanpa ini memakai file .data/alba.db
TURSO_DATABASE_URL=libsql://nama-db-anda.turso.io
TURSO_AUTH_TOKEN=

# Akun pemilik pertama, hanya dipakai saat tabel pengguna masih kosong.
# Setelah login pertama, ganti password di menu Akun lalu hapus ADMIN_PASSWORD.
ADMIN_USERNAME=pemilik
ADMIN_PASSWORD=
